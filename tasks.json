{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌐 Frontend: Start Dev Server (Vite)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🚀 Backend: Start FastAPI Server",
      "type": "shell",
      "command": "uvicorn server:app --reload --port 8000",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🧠 Backend: Ingest PDFs & Build Vector DB",
      "type": "shell",
      "command": "python build_index.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📄 Backend: Generate BIS Standard PDFs",
      "type": "shell",
      "command": "python generate_bis_pdfs.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📦 Frontend: Build Production Bundle",
      "type": "npm",
      "script": "build",
      "group": "build"
    }
  ]
}
